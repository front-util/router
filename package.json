{
  "name": "@front-utils/router-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "example": "turbo run dev --filter=@front-utils/example",
    "build": "turbo run build",
    "check-lint": "turbo run check-lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "turbo run test:e2e:ui",
    "test:e2e:install": "playwright install chromium",
    "validate": "turbo run check-lint check-types test",
    "pub": "turbo run build --filter=@front-utils/router && npm run pub --workspace @front-utils/router"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --no-stash",
    "pre-push": "npm run test",
    "preserveUnused": true
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
