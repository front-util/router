{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**",
        "types/**"
      ]
    },
    "check-lint": {
      "cache": false
    },
    "check-types": {},
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "cache": false,
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ]
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "test:e2e:install": {
      "cache": false
    }
  }
}
