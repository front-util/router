{
  "name": "@front-utils/router",
  "version": "0.7.0",
  "description": "Client simple hash router with signals",
  "author": "IVGolubev",
  "license": "ISC",
  "type": "module",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "https://git@github.com:front-util/router.git"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hashRouter": {
      "types": "./types/core/hashRouter.d.ts",
      "import": "./dist/hashRouter.js",
      "default": "./dist/hashRouter.js"
    },
    "./hashNavigation": {
      "types": "./types/core/hashNavigation.d.ts",
      "import": "./dist/hashNavigation.js",
      "default": "./dist/hashNavigation.js"
    },
    "./react": {
      "types": "./types/react/ClientRouter.d.ts",
      "import": "./dist/react/ClientRouter.js",
      "default": "./dist/react/ClientRouter.js"
    },
    "./types": "./types/index.d.ts",
    "./types/*": "./types/*.d.ts"
  },
  "scripts": {
    "check-lint": "eslint --max-warnings=0 --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "rm -rf dist && rm -rf types && npm run build:types && npm run build:rspack",
    "build:rspack": "rspack build",
    "build:types": "tsc --p tsconfig.build.json",
    "pub": "npm run build && npm publish --access public"
  },
  "browserslist": [
    "chrome > 83",
    "safari > 14.0"
  ],
  "publishConfig": {
    "access": "public",
    "ignore": [
      ".github/",
      "tsconfig.json"
    ]
  },
  "keywords": [
    "Javascript",
    "Router",
    "Navigation router",
    "Hash router",
    "Simple router",
    "Signals router"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@front-utils/linter": "^2.1.0",
    "@rspack/cli": "^1.3.5",
    "@rspack/core": "^1.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.1",
    "css-loader": "^6.8.1",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-x": "^5.18.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.9.0",
    "happy-dom": "^12.10.3",
    "lint-staged": "^15.2.10",
    "react": "*",
    "react-dom": "*",
    "simple-git-hooks": "^2.11.1",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.1.1",
    "vite": "^6.3.2",
    "vite-plugin-circular-dependency": "0.5.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.0.0"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "optionalDependencies": {
    "@preact/signals-react": "*"
  },
  "dependencies": {
    "@preact/signals": "*"
  }
}
